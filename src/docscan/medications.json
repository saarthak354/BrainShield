  "lab_tests": {
    "hba1c": {
      "aliases": [
        "hba1c",
        "hb a1c",
        "glycosylated haemoglobin",
        "glycosylated hemoglobin",
        "glycated haemoglobin",
        "glycated hemoglobin",
        "a1c"
      ],
      "unit": "%",
      "implies": "diabetes",
      "rule": ">= 6.5 indicates diabetes; 5.7-6.4 is prediabetes",
      "threshold": 6.5,
      "plausible_range": [
        3.0,
        20.0
      ]
    },
    "fasting_glucose": {
      "aliases": [
        "fasting blood sugar",
        "fasting glucose",
        "fbs",
        "fasting plasma glucose",
        "fpg"
      ],
      "unit": "mg/dL",
      "implies": "diabetes",
      "rule": ">= 126 mg/dL on two occasions indicates diabetes",
      "threshold": 126,
      "plausible_range": [
        40,
        600
      ]
    },
    "systolic_bp": {
      "aliases": [
        "blood pressure",
        "bp",
        "systolic"
      ],
      "unit": "mmHg",
      "implies": "sbp",
      "rule": "the upper number; used directly by the model",
      "plausible_range": [
        70,
        260
      ]
    },
    "total_cholesterol": {
      "aliases": [
        "total cholesterol",
        "cholesterol total",
        "s. cholesterol"
      ],
      "unit": "mg/dL",
      "implies": null,
      "plausible_range": [
        50,
        500
      ]
    },
    "ldl": {
      "aliases": [
        "ldl",
        "ldl cholesterol",
        "low density lipoprotein"
      ],
      "unit": "mg/dL",
      "implies": null,
      "plausible_range": [
        10,
        400
      ]
    },
    "creatinine": {
      "aliases": [
        "creatinine",
        "s. creatinine",
        "serum creatinine"
      ],
      "unit": "mg/dL",
      "implies": null,
      "plausible_range": [
        0.2,
        15.0
      ]
    }
  },
  "_not_inferred": [
    "Beta-blockers are listed under antihypertensive but are also used for rate control",
    "in atrial fibrillation and after myocardial infarction. They therefore set only",
    "on_htn_meds, never atrial_fib or prevalent_cvd, and the user is asked to confirm.",
    "",
    "No drug class sets atrial_fib directly. Anticoagulants and antiarrhythmics are",
    "strong hints, but warfarin is also given for venous thrombosis and mechanical",
    "valves, so they raise a question rather than an answer."
  ]
}